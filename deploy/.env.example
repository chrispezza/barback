# Copy to deploy/.env (gitignored) and fill in.
# Generate a key: openssl rand -base64 32
MEILI_MASTER_KEY=

# Public origin of the single-origin front door (no trailing slash).
# Use http://<lan-ip>:8080 to reach the app from a phone on the LAN.
BARBACK_ORIGIN=http://localhost:8080

# Registration is closed by default. For FIRST BOOT only: set this to "true",
# run scripts/seed.sh to create your user, then set it back to "false" and
# `docker compose up -d` again.
# ALLOW_REGISTRATION=true
