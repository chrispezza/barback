{
  "name": "barback",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/check.mjs",
    "test": "vitest",
    "build": "node scripts/check.mjs && tsc -b && vitest run && vite build",
    "verify": "playwright test",
    "preview": "vite preview",
    "build:deploy": "node scripts/check.mjs && tsc -b && vitest run && VITE_API_URL=/bar VITE_MEILISEARCH_URL=/search vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "preact": "^10.29.7",
    "preact-iso": "^2.12.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.13.3",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
