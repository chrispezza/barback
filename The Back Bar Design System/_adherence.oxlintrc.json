{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/drinks/**",
              "components/feedback/**",
              "components/forms/**",
              "components/inventory/**",
              "components/navigation/**",
              "components/shopping/**",
              "ui_kits/back-bar-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Libre Caslon Display|Libre Caslon Text|Instrument Sans))/i]",
        "message": "Font not provided by the design system. Available: Libre Caslon Display, Libre Caslon Text, Instrument Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DrinkCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|family|ingredients|match|onSelect|key|ref|className|style|children)$/]",
        "message": "<DrinkCard> doesn't accept that prop. Declared props: name, family, ingredients, match, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='DrinkCard'] > JSXAttribute[name.name='match'] > Literal[value!=/^(?:full|partial|near|none)$/]",
        "message": "<DrinkCard> match must be one of 'full' | 'partial' | 'near' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='FamilyFilterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:families|value|onChange|disabled|key|ref|className|style|children)$/]",
        "message": "<FamilyFilterBar> doesn't accept that prop. Declared props: families, value, onChange, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='IngredientChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|count|disabled|onToggle|key|ref|className|style|children)$/]",
        "message": "<IngredientChip> doesn't accept that prop. Declared props: label, state, count, disabled, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='IngredientChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|have|absent)$/]",
        "message": "<IngredientChip> state must be one of 'default' | 'have' | 'absent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|count|tone|align|key|ref|className|style|children)$/]",
        "message": "<MatchHeader> doesn't accept that prop. Declared props: label, count, tone, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|gap)$/]",
        "message": "<MatchHeader> tone must be one of 'neutral' | 'gap'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MatchHeader'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<MatchHeader> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModalFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|footer|overlay|onDismiss|key|ref|className|style|children)$/]",
        "message": "<ModalFrame> doesn't accept that prop. Declared props: eyebrow, title, children, footer, overlay, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuantityStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|unit|onChange|key|ref|className|style|children)$/]",
        "message": "<QuantityStepper> doesn't accept that prop. Declared props: value, min, max, step, unit, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatioDevice'] > JSXAttribute > JSXIdentifier[name!=/^(?:parts|size|key|ref|className|style|children)$/]",
        "message": "<RatioDevice> doesn't accept that prop. Declared props: parts, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='RatioDevice'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<RatioDevice> size must be one of 'lg' | 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|label|disabled|onChange|onClear|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, placeholder, label, disabled, onChange, onClear."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShelfRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|brand|volume|remaining|empty|onRemove|key|ref|className|style|children)$/]",
        "message": "<ShelfRow> doesn't accept that prop. Declared props: name, brand, volume, remaining, empty, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShoppingListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|unlocks|note|checked|onToggle|key|ref|className|style|children)$/]",
        "message": "<ShoppingListItem> doesn't accept that prop. Declared props: name, unlocks, note, checked, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|actionLabel|onAction|tone|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, actionLabel, onAction, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|destructive)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'destructive'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
